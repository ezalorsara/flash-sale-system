# Server
PORT=4000

# Redis - atomic concurrency gate
REDIS_URL=redis://127.0.0.1:6379

# MongoDB - durable source of truth
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=flashsale

# Sale configuration (seeded into Mongo + Redis on boot)
PRODUCT_ID=flash-item-1
PRODUCT_NAME=Limited Edition Sneaker
SALE_TOTAL_STOCK=50
# ISO 8601. Leave unset to default to "starts now, ends in 10 minutes".
SALE_START_AT=
SALE_END_AT=
